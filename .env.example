# Flask
FLASK_ENV=development
FLASK_SECRET_KEY=change-me-in-production
APP_NAME=white-moon

# Database (local docker-compose)
DATABASE_URL=postgresql+psycopg://wm:wm@localhost:5433/whitemoon

# Redis / Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# JWT
JWT_SECRET_KEY=change-me-in-production
JWT_ACCESS_TOKEN_EXPIRES_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRES_DAYS=30

# Object storage (local MinIO in dev)
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=wm-dev
S3_SECRET_KEY=wm-dev-secret
S3_REGION=us-east-1
S3_BUCKET_RECEIPTS=wm-dev-receipts
S3_BUCKET_CHAT=wm-dev-chat
S3_BUCKET_KYC=wm-dev-kyc
S3_BUCKET_INVOICES=wm-dev-invoices

# Email (local MailHog in dev; no TLS/auth). In prod use real SMTP with
# SMTP_STARTTLS=true + SMTP_USER/SMTP_PASSWORD — credentials are never sent
# without STARTTLS.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=no-reply@whitemoon.local
SMTP_STARTTLS=false

# OTP providers (fill when provisioning)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
TWILIO_WHATSAPP_FROM=

# OCR — receipt matching (US-3.3). Dev/tests use the stub; set "tesseract"
# in prod (Tesseract binary + ara/eng traineddata installed on the server).
OCR_PROVIDER=stub
TESSERACT_CMD=tesseract
OCR_LANG=ara+eng

# Maps (populated for Phase 8/9)
GOOGLE_MAPS_API_KEY=
