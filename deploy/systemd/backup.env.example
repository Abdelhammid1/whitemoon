# Installed at /etc/white-moon/backup.env (chmod 600). Consumed by the backup
# and restore-drill systemd units. Keep PGPASSWORD here or use ~/.pgpass.
PGHOST=localhost
PGPORT=5432
PGUSER=wm
PGDATABASE=whitemoon
PGPASSWORD=change-me
BACKUP_DIR=/var/backups/whitemoon
RETENTION_DAYS=14
# Off-site copy (optional) — a configured rclone remote, e.g. a Hetzner
# Storage Box or Object Storage bucket:
# RCLONE_REMOTE=hetzner-box:whitemoon/pg
